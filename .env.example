# Configuracao compartilhada pelo Docker Compose e pelo backend local.
POSTGRES_DB=petmatch
POSTGRES_USER=petmatch
# Exemplo local: escolha sua senha no .env antes da primeira inicializacao.
POSTGRES_PASSWORD=petmatch_local_dev
# Porta publicada no computador; 5433 evita conflito com PostgreSQL nativo.
POSTGRES_PORT=5433
# Host do banco visto pelo NestJS executado fora do Docker.
POSTGRES_HOST=127.0.0.1
# Porta HTTP do NestJS (nao confundir com a porta do PostgreSQL).
PORT=3000
